<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only sanity check of all game scripts against Unity reference assemblies, for
    environments without the Unity editor:  dotnet build Tools/UnityCompileCheck
    Passing this does not guarantee the project runs in Unity; it catches syntax/API errors.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/**/*.cs" />
    <!-- Stand-ins for package APIs (Input System) that aren't on NuGet. -->
    <Compile Include="Stubs/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
  </ItemGroup>
</Project>
